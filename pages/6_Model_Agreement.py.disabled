    "loan_predictions.db"
)


# ============================================================
# DATABASE
# ============================================================

def create_database():
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute(
        """
        CREATE TABLE IF NOT EXISTS predictions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp TEXT,
            model TEXT,
            prediction TEXT,
            probability REAL,
            applicant_income REAL,
            coapplicant_income REAL,
            total_income REAL,
            loan_amount REAL,
            loan_to_income REAL,
            credit_history REAL,
            education TEXT,
            property_area TEXT
        )
        """
    )
    conn.commit()
    conn.close()


create_database()


